/*
 * Cygnus 3x5 - keymap
 *
 * Based on the Cygnus 3x6 keymap (cygnus3x6_xiao branch) with the
 * outer column removed. Former outer-column keys:
 *   ESC          -> Z + X combo
 *   TAB          -> left thumb (already there)
 *   MINUS / '    -> O + P / DOT + SLASH combos (already there)
 *   GUI/CTRL/ALT -> home-row mods (already there)
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    combos {
        compatible = "zmk,combos";

        /*
         * Left thumb TAB + right thumb SHIFT -> Layer 6 (Settings) while held
         *
         * Cygnus 3x5 positions:
         * TAB (left thumb)   = 30
         * SHIFT (right thumb) = 35
         */
        settings_layer {
            timeout-ms = <60>;
            key-positions = <30 35>;
            bindings = <&mo 6>;
        };

        /*
         * SPACE + ENTER simultaneously -> hold Layer 7 (Media)
         * Only on the Base layers (0 = Mac, 1 = Windows)
         */
        media_layer {
            timeout-ms = <60>;
            key-positions = <32 33>;
            bindings = <&mo 7>;
            layers = <0 1>;
        };

        /*
         * Z + X simultaneously -> ESC
         * (ESC lost its own key with the outer column)
         *
         * Cygnus 3x5 positions:
         * Z = 20, X = 21
         */
        esc_combo {
            timeout-ms = <60>;
            key-positions = <20 21>;
            bindings = <&kp ESC>;
        };

        /*
         * C + V simultaneously -> 英数 (LANG2)
         * M + COMMA simultaneously -> かな (LANG1)
         *
         * Cygnus 3x5 positions:
         * C = 22, V = 23
         * M = 26, COMMA = 27
         */
        eisu_combo {
            timeout-ms = <60>;
            key-positions = <22 23>;
            bindings = <&kp LANG2>;
        };

        kana_combo {
            timeout-ms = <60>;
            key-positions = <26 27>;
            bindings = <&kp LANG1>;
        };

        /*
         * O + P simultaneously -> MINUS (-)
         * DOT + SLASH simultaneously -> SINGLE_QUOTE (')
         * Only on the Base layers (0 = Mac, 1 = Windows)
         *
         * Cygnus 3x5 positions:
         * O = 8, P = 9
         * DOT = 28, SLASH = 29
         */
        hyphen_combo {
            timeout-ms = <60>;
            key-positions = <8 9>;
            bindings = <&kp MINUS>;
            layers = <0 1>;
        };

        quote_combo {
            timeout-ms = <60>;
            key-positions = <28 29>;
            bindings = <&kp SINGLE_QUOTE>;
            layers = <0 1>;
        };

        /*
         * B + T + O simultaneously -> bootloader
         * (same as double-pressing the reset button)
         *
         * Cygnus 3x5 positions:
         * T = 4
         * O = 8
         * B = 24
         */
        bootloader_combo {
            timeout-ms = <100>;
            key-positions = <4 8 24>;
            bindings = <&bootloader>;
        };
    };

    /*
     * Bluetooth profile + OS Base layer switch in one key press
     *
     * Profile 0, 1 -> Mac     (Layer 0)
     * Profile 2, 3 -> Windows (Layer 1)
     *
     * &to deactivates every layer except the default layer (0) and
     * activates the target, so it also cancels a stuck momentary layer.
     * Windows Base (1) must stay below Symbols/Num/Nav (2+): the highest
     * active layer wins, so temporary layers can only sit above it.
     */
    macros {
        mac_bt_0: mac_bt_0 {
            compatible = "zmk,behavior-macro";
            label = "MAC_BT_0";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 0 &to 0>;
        };

        mac_bt_1: mac_bt_1 {
            compatible = "zmk,behavior-macro";
            label = "MAC_BT_1";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 1 &to 0>;
        };

        win_bt_2: win_bt_2 {
            compatible = "zmk,behavior-macro";
            label = "WIN_BT_2";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 2 &to 1>;
        };

        win_bt_3: win_bt_3 {
            compatible = "zmk,behavior-macro";
            label = "WIN_BT_3";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 3 &to 1>;
        };
    };

    behaviors {
        /*
         * Home-row mods
         * Hold decision: 250 ms
         */

        hml: home_row_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_LEFT";
            #binding-cells = <2>;

            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions =
                <5 6 7 8 9
                 15 16 17 18 19
                 25 26 27 28 29>;

            hold-trigger-on-release;
        };

        hmr: home_row_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_RIGHT";
            #binding-cells = <2>;

            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions =
                <0 1 2 3 4
                 10 11 12 13 14
                 20 21 22 23 24>;

            hold-trigger-on-release;
        };

        /*
         * Modifier-tap
         * e.g. TAB/Shift, KANA/Shift
         */
        mt250: mod_tap_250 {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_250";
            #binding-cells = <2>;

            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";

            bindings = <&kp>, <&kp>;
        };

        /*
         * Layer-tap
         *
         * arg1 = layer
         * arg2 = tap key
         */
        lt250: layer_tap_250 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_250";
            #binding-cells = <2>;

            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";

            bindings = <&mo>, <&kp>;
        };
    };


    keymap {
        compatible = "zmk,keymap";


        /*
         * ==========================================================
         * Layer 0 - BASE (Mac)
         *
         * Selected by Bluetooth profile 0 / 1 (&mac_bt_0 / &mac_bt_1)
         * ==========================================================
         *
         * LEFT                          RIGHT
         *
         * Q     W   E   R   T      Y   U   I   O   P
         * A/SFT S   D   F   G      H   J   K   L   ;/SFT
         * Z     X   C   V   B      N   M   ,   .   /
         *
         * Z+X -> ESC combo
         * C+V -> 英数 (LANG2) combo, M+COMMA -> かな (LANG1) combo
         * O+P -> MINUS combo, DOT+SLASH -> SINGLE_QUOTE combo
         * G/H long-press -> GUI+SHIFT
         * A / ; long-press -> SHIFT
         * aerospace (macOS tiling WM) tuning: ALT <-> CONTROL swapped
         * on S/D and K/L vs. the stock layout
         *
         *       TAB/SFT BSPC/L3 SPACE/L2   ENTER/L4 -   RSHIFT
         */

        default_layer {
            display-name = "Base";

            bindings = <

&kp Q                 &kp W                 &kp E                &kp R                &kp T
&kp Y                 &kp U                 &kp I                &kp O                &kp P

&hml LEFT_SHIFT A     &hml LEFT_ALT S       &hml LEFT_CONTROL D  &hml LEFT_GUI F      &mt250 LS(LGUI) G
&mt250 LS(LGUI) H     &hmr RIGHT_GUI J      &hmr RIGHT_CONTROL K &hmr RIGHT_ALT L     &mt250 RIGHT_SHIFT SEMI

&kp Z                 &kp X                 &kp C                &kp V                &kp B
&kp N                 &kp M                 &kp COMMA            &kp DOT              &kp SLASH

                         &mt250 LEFT_SHIFT TAB
                         &lt250 3 BACKSPACE
                         &lt250 2 SPACE
                         &lt250 4 ENTER
                         &kp MINUS
                         &kp RIGHT_SHIFT
            >;
        };


        /*
         * ==========================================================
         * Layer 1 - BASE (Windows)
         *
         * Selected by Bluetooth profile 2 / 3 (&win_bt_2 / &win_bt_3)
         * Copy of Layer 0 with GUI <-> CTRL swapped on the home row.
         * LANG1 / LANG2 are kept as-is.
         *
         * Q     W   E   R   T      Y   U   I   O   P
         * A     GUI ALT CTRL G     H   CTRL ALT GUI ;/SFT
         * Z     X   C   V   B      N   M   ,   .   /
         *
         * Z+X -> ESC combo
         * C+V -> 英数 (LANG2) combo, M+COMMA -> かな (LANG1) combo
         * O+P -> MINUS combo, DOT+SLASH -> SINGLE_QUOTE combo
         * G/H long-press -> GUI+SHIFT
         * ; long-press -> SHIFT
         *
         *       TAB/SFT BSPC/L3 SPACE/L2   ENTER/L5 -   RSHIFT
         * ==========================================================
         */

        windows_layer {
            display-name = "Base (Win)";

            bindings = <

&kp Q                 &kp W                 &kp E                &kp R                &kp T
&kp Y                 &kp U                 &kp I                &kp O                &kp P

&kp A                 &hml LEFT_GUI S       &hml LEFT_ALT D      &hml LEFT_CONTROL F  &mt250 LS(LGUI) G
&mt250 LS(LGUI) H     &hmr RIGHT_CONTROL J  &hmr RIGHT_ALT K     &hmr RIGHT_GUI L     &mt250 RIGHT_SHIFT SEMI

&kp Z                 &kp X                 &kp C                &kp V                &kp B
&kp N                 &kp M                 &kp COMMA            &kp DOT              &kp SLASH

                         &mt250 LEFT_SHIFT TAB
                         &lt250 3 BACKSPACE
                         &lt250 2 SPACE
                         &lt250 5 ENTER
                         &kp MINUS
                         &kp RIGHT_SHIFT
            >;
        };


        /*
         * ==========================================================
         * Layer 2 - SYMBOL
         * Conductor L1 based
         * ==========================================================
         */

        symbol_layer {
            display-name = "Symbols";

            bindings = <

&kp EXCL              &kp AT                &kp HASH             &kp DLLR             &kp PRCNT
&kp CARET             &kp AMPS              &kp ASTRK            &kp BSLH             &kp GRAVE

&kp SINGLE_QUOTE      &kp LT                &kp LBRC             &kp LBKT             &kp LPAR
&kp RPAR              &kp RBKT              &kp RBRC             &kp GT               &kp SEMI

&trans                &trans                &trans               &kp TILDE            &kp PIPE
&kp EQUAL             &kp PLUS              &kp MINUS            &kp ASTRK            &kp SLASH

                         &trans
                         &trans
                         &trans
                         &trans
                         &trans
                         &trans
            >;
        };


        /*
         * ==========================================================
         * Layer 3 - FUNCTION / NUMPAD
         *
         * MINUS / SLASH (outer column on 3x6) moved to the free
         * slots at the bottom-left.
         * DELETE sits on the right thumb (same key that is MINUS on
         * the Base layers): hold BSPC/L3 + that key -> DELETE.
         * ==========================================================
         */

        function_layer {
            display-name = "Fn / Num";

            bindings = <

&kp F1                &kp F2                &kp F3               &kp F4               &kp F5
&kp N0                &kp N1                &kp N2               &kp N3               &kp PLUS

&kp F6                &kp F7                &kp F8               &kp F9               &kp F10
&kp DOT               &kp N4                &kp N5               &kp N6               &kp ASTRK

&kp F11               &kp F12               &trans               &kp MINUS            &kp SLASH
&kp COMMA             &kp N7                &kp N8               &kp N9               &kp EQUAL

                         &trans
                         &trans
                         &trans
                         &trans
                         &kp DELETE
                         &trans
            >;
        };


        /*
         * ==========================================================
         * Layer 4 - NAVIGATION / macOS
         *
         * Reached from Mac Base (Layer 0) via ENTER/L4
         * ==========================================================
         */

        navigation_layer {
            display-name = "Navigation";

            bindings = <

&trans                &trans                &trans               &trans               &trans
&kp LC(UP_ARROW)      &kp LC(LEFT_ARROW)    &kp UP_ARROW         &kp LC(RIGHT_ARROW)  &kp LC(DOWN_ARROW)

&kp LS(LG(N3))        &kp LS(LG(N4))        &kp LS(LG(N5))       &trans               &trans
&kp LC(A)             &kp LEFT_ARROW        &kp DOWN_ARROW       &kp RIGHT_ARROW      &kp LC(E)

&kp LS(LG(LC(N3)))    &kp LS(LG(LC(N4)))    &kp LS(LG(LC(N5)))   &trans               &trans
&kp C_PREV            &kp LG(LEFT_ARROW)    &trans               &kp LG(RIGHT_ARROW)  &kp C_NEXT

                         &trans
                         &trans
                         &trans
                         &trans
                         &trans
                         &trans
            >;
        };


        /*
         * ==========================================================
         * Layer 5 - NAVIGATION / Windows
         *
         * Reached from Windows Base (Layer 1) via ENTER/L5.
         * Same as the cygnus3x6_keymap_windows branch:
         * Row1: Win+PrtScn / Win+Shift+S / PrtScn
         * Row2: Win+Alt+PrtScn / Win+Alt+R / Win+G (Game Bar)
         * HOME/END replace the emacs-style Ctrl+A/Ctrl+E (Select All / Find on Windows).
         * ==========================================================
         */

        windows_navigation_layer {
            display-name = "Nav (Win)";

            bindings = <

&trans                &trans                &trans               &trans               &trans
&kp LC(UP_ARROW)      &kp LC(LEFT_ARROW)    &kp UP_ARROW         &kp LC(RIGHT_ARROW)  &kp LC(DOWN_ARROW)

&kp LG(PSCRN)         &kp LS(LG(S))         &kp PSCRN            &trans               &trans
&kp HOME              &kp LEFT_ARROW        &kp DOWN_ARROW       &kp RIGHT_ARROW      &kp END

&kp LG(LA(PSCRN))     &kp LG(LA(R))         &kp LG(G)            &trans               &trans
&kp C_PREV            &kp LG(LEFT_ARROW)    &trans               &kp LG(RIGHT_ARROW)  &kp C_NEXT

                         &trans
                         &trans
                         &trans
                         &trans
                         &trans
                         &trans
            >;
        };


        /*
         * ==========================================================
         * Layer 6 - SETTINGS / Bluetooth
         *
         * Left thumb TAB + right thumb SHIFT simultaneously -> hold Layer 6
         *
         * BT 0/1 -> Mac Base, BT 2/3 -> Windows Base (macros)
         * ==========================================================
         */

        settings_layer {
            display-name = "Bluetooth";

            bindings = <

&studio_unlock        &trans                &trans               &trans               &trans
&mac_bt_0             &mac_bt_1             &win_bt_2            &win_bt_3            &bt BT_SEL 4

&trans                &trans                &trans               &trans               &trans
&trans                &trans                &trans               &trans               &trans

&trans                &trans                &trans               &trans               &sys_reset
&bootloader           &trans                &trans               &bt BT_CLR_ALL       &bt BT_CLR

                         &trans
                         &trans
                         &trans
                         &trans
                         &trans
                         &trans
            >;
        };

        /*
         * ==========================================================
         * Layer 7 - MEDIA / Mouse
         *
         * SPACE + ENTER simultaneously -> hold Layer 7
         * POWER (outer column on 3x6) moved to the bottom-left.
         * ==========================================================
         */

        media_layer {
            display-name = "Media";

            bindings = <

&kp C_BRI_DN          &kp C_BRI_UP          &kp C_MUTE           &kp C_VOL_DN         &kp C_VOL_UP
&kp C_PLAY_PAUSE      &kp C_PREV            &mmv MOVE_UP         &kp C_NEXT           &trans

&trans                &mkp LCLK             &mkp MCLK            &mkp RCLK            &trans
&trans                &mmv MOVE_LEFT        &mmv MOVE_DOWN       &mmv MOVE_RIGHT      &trans

&kp C_POWER           &trans                &trans               &trans               &trans
&trans                &trans                &trans               &trans               &trans

                         &trans
                         &trans
                         &trans
                         &trans
                         &trans
                         &trans
            >;
        };
    };
};
